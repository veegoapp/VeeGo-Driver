{
  "cli": {
    "version": ">=14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "<APPLE_ID_EMAIL>",
        "ascAppId": "<APP_STORE_CONNECT_APP_ID>",
        "appleTeamId": "<APPLE_TEAM_ID>"
      }
    }
  }
}
