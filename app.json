{
  "expo": {
    "name": "VeeGo Driver",
    "slug": "veego-driver",
    "owner": "mohamedfarghaly91",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "veego-driver",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veego.driver"
    },
    "android": {
      "backgroundColor": "#1B1F2E",
      "package": "com.veego.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-av",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2d2d42",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/trip_request.wav",
            "./assets/sounds/shuttle_approaching.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow VeeGo Driver to use your location while you're online.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VeeGo Driver to access your photos for document upload.",
          "cameraPermission": "Allow VeeGo Driver to use the camera for document upload."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "11857108-9eef-47d8-ba83-6512a97a88bb"
      }
    }
  }
}
