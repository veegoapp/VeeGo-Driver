# ── Dependencies (EAS installs these automatically) ──────────────────────────
node_modules/

# ── Replit-specific runtime & store (not needed on EAS servers) ──────────────
.local/
.cache/
.config/
.replit
.replitignore

# ── Replit agent memory & skills ─────────────────────────────────────────────
.agents/

# ── Claude AI settings ────────────────────────────────────────────────────────
.claude/

# ── GitHub CI workflows (EAS has its own pipeline) ───────────────────────────
.github/

# ── Design preview files (not part of the app bundle) ────────────────────────
design-prototypes/

# ── Local build output (Replit static-build only, not an Expo/EAS artifact) ──
static-build/

# ── Local scripts (setup.sh is Replit bootstrap; build.js is static-build only)
scripts/

# ── Uploaded reference files (screenshots, prompts, source images) ────────────
attached_assets/

# ── Internal documentation (no effect on the build) ──────────────────────────
docs/
README.md
DRIVER_APP_PRODUCTION_AUDIT.md
VeeGo_Driver_Production_UX_Audit.md
"Driver App Cleanup Report.md"
driver-audit-verification-report.md
driver-local-fixes-report.md
PUSH_NOTIFICATIONS_SETUP.md
IOS_SETUP.md

# ── Environment files (values are supplied via EAS Secrets instead) ───────────
.env
.env.example

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
